# ==============================================================================
# MR.BOB CREATOR HUB — SUPABASE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate with your Supabase credentials:
#   cp .env.example .env.local
#
# Credentials can be found in your Supabase Dashboard:
#   Settings -> API (Project URL & API Keys)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT CONFIGURATION (PUBLIC / SAFE FOR CLIENT BROWSER)
# ------------------------------------------------------------------------------
# Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Project Anon / Publishable API Key (safe for client-side usage, governed by RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here

# ------------------------------------------------------------------------------
# 2. SUPABASE SERVICE ROLE CONFIGURATION (PRIVATE / SERVER ONLY)
# ------------------------------------------------------------------------------
# Project Secret / Service Role Key
# ⚠️ NEVER expose this key to client-side code or browser bundles!
# Used only by server-side operations and CLI scripts (e.g., scripts/provision-admin.ts)
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
